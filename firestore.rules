rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'atharva15181389@gmail.com',
        'brbagane@tkietwarana.ac.in',
        'itsmey661@gmail.com'
      ];
    }
    
    // Allow public read access to directory and equipment details
    match /coordinators/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ambassdors/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ambassador_settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /printer_details/{document} {
      allow read: if true;
      // Allow anyone to update printer status (start/release a session)
      allow update: if true;
      allow create, delete: if isAdmin();
    }
    match /printer_details/{printerId}/history/{document} {
      allow read: if isAdmin();
      // Allow anyone to log print history records
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    // Allow public submissions to the form collections (no auth required to submit)
    match /regular_attendance/{document} {
      allow create: if true;
    }
    
    match /meeting_attendance/{document} {
      allow create: if true;
    }
    
    match /workshop_attendance/{document} {
      allow create: if true;
    }
    
    match /feedback/{document} {
      allow create: if true;
    }
    
    match /questionnaire_responses/{document} {
      allow create: if true;
    }

    // Allow authenticated users to read all collections, but only admins to write
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
